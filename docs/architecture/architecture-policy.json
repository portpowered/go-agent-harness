{
  "version": 1,
  "module_dirs": [
    "agent-cli",
    "go-agent-loop",
    "go-audio",
    "go-device-gateway",
    "go-llm-gateway",
    "go-agent-runtime",
    "tests/embedding",
    "tools/architecturegate",
    "tools/analyzergate",
    "tools/coveragegate",
    "tools/racegate",
    "tools/timingate",
    "tests/localai"
  ],
  "patterns": [
    "./..."
  ],
  "service_roots": [
    "services/*"
  ],
  "composition_roots": [
    "wire",
    "runtime/wire",
    "github.com/portpowered/go-agent-harness/go-agent-runtime",
    "example.com/agent-runtime-consumer"
  ],
  "composition_registry": [
    {
      "module": "example.com/agent-runtime-consumer",
      "package": "example.com/agent-runtime-consumer",
      "reason": "external consumer owns application service composition"
    },
    {
      "module": "github.com/portpowered/go-agent-harness/agent-cli",
      "package": "github.com/portpowered/go-agent-harness/agent-cli/internal/acceptance",
      "file": "internal/acceptance/ask_stream_test.go",
      "reason": "acceptance host assembles the public session wire"
    },
    {
      "module": "github.com/portpowered/go-agent-harness/agent-cli",
      "package": "github.com/portpowered/go-agent-harness/agent-cli/internal/services",
      "file": "internal/services/chat_repl_test.go",
      "reason": "CLI host test assembles the public session wire"
    },
    {
      "module": "github.com/portpowered/go-agent-harness/agent-cli",
      "package": "github.com/portpowered/go-agent-harness/agent-cli/internal/transport/cli",
      "file": "internal/transport/cli/ask_test.go",
      "reason": "CLI transport test assembles the public session wire"
    },
    {
      "module": "github.com/portpowered/go-agent-harness/agent-cli",
      "package": "github.com/portpowered/go-agent-harness/agent-cli/internal/transport/cli",
      "file": "internal/transport/cli/chat_test.go",
      "reason": "CLI transport test assembles the public session wire"
    },
    {
      "module": "github.com/portpowered/go-agent-harness/agent-cli",
      "package": "github.com/portpowered/go-agent-harness/agent-cli/internal/transport/cli",
      "file": "internal/transport/cli/command_path_resolver_test.go",
      "reason": "CLI path test assembles public service wires"
    },
    {
      "module": "github.com/portpowered/go-agent-harness/agent-cli",
      "package": "github.com/portpowered/go-agent-harness/agent-cli/internal/transport/cli",
      "file": "internal/transport/cli/room_service_composition_test.go",
      "reason": "CLI room test assembles public device and room wires"
    },
    {
      "module": "github.com/portpowered/go-agent-harness/agent-cli",
      "package": "github.com/portpowered/go-agent-harness/agent-cli/test/integration",
      "file": "test/integration/session_service_composition_test.go",
      "reason": "CLI integration host assembles the public session wire"
    },
    {
      "module": "github.com/portpowered/go-agent-harness/go-agent-runtime",
      "package": "github.com/portpowered/go-agent-harness/go-agent-runtime/services/replay",
      "file": "services/replay/service_public_integrity_test.go",
      "reason": "replay public contract test exercises the service through generated Wire"
    }
  ],
  "module_rules": [
    {
      "module": "github.com/portpowered/go-agent-harness/go-agent-runtime",
      "allowed_top_level": [
        ".",
        "services",
        "wire",
        "platform"
      ]
    },
    {
      "module": "example.com/agent-runtime-consumer",
      "allowed_top_level": [
        ".",
        "cmd"
      ]
    }
  ],
  "forbidden_imports": [
    {
      "from": [
        "github.com/portpowered/go-agent-harness/go-agent-runtime"
      ],
      "imports": [
        "github.com/portpowered/go-agent-harness/go-agent-runtime/services/**/wire"
      ],
      "reason": "the runtime entrypoint composes through its module Wire injector"
    },
    {
      "from": [
        "github.com/portpowered/go-agent-harness/agent-cli/internal/services/tools"
      ],
      "imports": [
        "**/services/internal/**"
      ],
      "files": [
        "internal/services/tools/interface.go"
      ],
      "reason": "the public tool contract does not expose private service implementations"
    },
    {
      "from": [
        "github.com/portpowered/go-agent-harness/agent-cli/internal/services/devices",
        "github.com/portpowered/go-agent-harness/agent-cli/internal/transport/cli"
      ],
      "imports": [
        "**/services/internal/**"
      ],
      "files": [
        "internal/services/devices/interface.go",
        "internal/transport/cli/devices.go",
        "internal/transport/cli/probe.go",
        "internal/transport/cli/probe_output.go"
      ],
      "reason": "the device contract and the device list/probe transports reach devices only through the public device service"
    },
    {
      "from": [
        "github.com/portpowered/go-agent-harness/agent-cli/internal/transport/cli",
        "github.com/portpowered/go-agent-harness/agent-cli/internal/transport/cli/**"
      ],
      "imports": [
        "**/services/internal/**"
      ],
      "production_only": true,
      "reason": "CLI transports use public service boundaries, never private service implementations"
    },
    {
      "from": [
        "github.com/portpowered/go-agent-harness/agent-cli/internal/**"
      ],
      "imports": [
        "**/services/servicetest",
        "**/services/servicetest/**"
      ],
      "production_only": true,
      "reason": "application code never imports acceptance-test runtime access; depguard cannot match a services/servicetest package in any module"
    }
  ],
  "forbidden_root_imports": [
    "os",
    "os/**",
    "os/exec",
    "os/signal",
    "net",
    "net/**",
    "net/http",
    "net/url",
    "syscall"
  ],
  "forbidden_source_patterns": [
    {
      "name": "hand-rolled-wav-container",
      "from": [
        "github.com/portpowered/go-agent-harness/agent-cli/**",
        "github.com/portpowered/go-agent-harness/go-agent-loop/**",
        "github.com/portpowered/go-agent-harness/go-agent-runtime/**",
        "github.com/portpowered/go-agent-harness/go-device-gateway/**",
        "github.com/portpowered/go-agent-harness/go-llm-gateway/**",
        "github.com/portpowered/go-agent-harness/tests/localai/**",
        "example.com/agent-runtime-consumer/**"
      ],
      "except_files": [
        "github.com/portpowered/go-agent-harness/agent-cli/internal/input/mimetype.go",
        "github.com/portpowered/go-agent-harness/agent-cli/test/integration/mimetype_validation_test.go"
      ],
      "literals": [
        "RIFF"
      ],
      "reason": "WAV containers are written, read and sniffed only by go-audio/pkg/wavio (Write, PCM16Header, Read, Inspect, IsRIFF); the exceptions sniff RIFF-based WebP images, not audio"
    },
    {
      "name": "hand-rolled-pcm16",
      "from": [
        "github.com/portpowered/go-agent-harness/agent-cli/**",
        "github.com/portpowered/go-agent-harness/go-agent-loop/**",
        "github.com/portpowered/go-agent-harness/go-agent-runtime/**",
        "github.com/portpowered/go-agent-harness/go-device-gateway/**",
        "github.com/portpowered/go-agent-harness/go-llm-gateway/**",
        "github.com/portpowered/go-agent-harness/tests/localai/**",
        "example.com/agent-runtime-consumer/**"
      ],
      "selectors": [
        "encoding/binary.LittleEndian.PutUint16",
        "encoding/binary.LittleEndian.AppendUint16",
        "encoding/binary.LittleEndian.Uint16"
      ],
      "reason": "PCM16 samples are packed, decoded and measured only by go-audio/pkg/codec (EncodePCM16, DecodePCM16, PCM16Samples, RMS, PCM16RMS); the exception is the standalone tests/localai conformance oracle, which keeps its own helpers so it stays independent of the go-audio code under test",
      "except_files": [
        "github.com/portpowered/go-agent-harness/tests/localai/protocol_test.go"
      ]
    }
  ],
  "generated_files": [
    {
      "module": "go-agent-runtime",
      "pattern": "services/replay/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "go-agent-runtime",
      "pattern": "services/session/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "go-agent-runtime",
      "pattern": "services/providers/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "agent-cli",
      "pattern": "internal/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "go-agent-runtime",
      "pattern": "services/tools/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "go-agent-runtime",
      "pattern": "services/devices/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "go-agent-runtime",
      "pattern": "services/rooms/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "go-agent-runtime",
      "pattern": "services/roomevidence/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "go-agent-runtime",
      "pattern": "services/roomreplay/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "go-agent-runtime",
      "pattern": "services/recording/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "go-agent-runtime",
      "pattern": "services/sessionduration/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "go-agent-runtime",
      "pattern": "services/sessionturn/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "go-agent-runtime",
      "pattern": "services/sessiontrace/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "go-agent-runtime",
      "pattern": "services/rtctransport/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    },
    {
      "module": "go-agent-runtime",
      "pattern": "services/selfplay/wire/wire_gen.go",
      "generator": "wire",
      "header": "// Code generated by Wire. DO NOT EDIT."
    }
  ]
}
