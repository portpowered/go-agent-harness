{
  "schema_version": "probe.scenario.v2",
  "id": "webmcp-stale-ref-recovery",
  "name": "WebMCP stale reference recovery",
  "description": "Capture a page-tool reference, navigate to a new page generation, reject the stale reference, rediscover the catalog, and retry with the new reference.",
  "browser_fixture": "stale-ref-recovery.browser.json",
  "provider_fixture": "stale-ref-recovery.provider.json",
  "steps": [
    {
      "type": "browser_connect",
      "browser_id": "fixture-browser"
    },
    {
      "type": "browser_discover",
      "browser_id": "fixture-browser"
    },
    {
      "type": "browser_select",
      "browser_id": "fixture-browser",
      "target_id": "tab-1"
    },
    {
      "type": "webmcp_wait_ready"
    },
    {
      "type": "webmcp_list_tools",
      "include_schemas": true
    },
    {
      "type": "browser_navigate_fixture",
      "url": "https://webmcp.example/next"
    },
    {
      "type": "webmcp_invoke",
      "tool_ref": "webmcp.tool-ref.v1:iXWiNo9N95l1B_hgbIvVDw",
      "input_json": "{\"key\":\"status\"}",
      "reason": "prove the pre-navigation reference is stale"
    },
    {
      "type": "webmcp_list_tools",
      "refresh": true,
      "include_schemas": true
    },
    {
      "type": "send_text",
      "text": "Retry with the rediscovered page-tool reference."
    },
    {
      "type": "webmcp_invoke",
      "tool_ref": "webmcp.tool-ref.v1:bw_tLpillf84ToOyaOBwbg",
      "input_json": "{\"key\":\"status\"}",
      "reason": "retry after rediscovery"
    },
    {
      "type": "close"
    }
  ],
  "expectations": [
    {
      "type": "browser_count_equals",
      "equals": 1
    },
    {
      "type": "selected_tab_equals",
      "target_id": "tab-1"
    },
    {
      "type": "selected_origin_equals",
      "origin": "https://webmcp.example"
    },
    {
      "type": "catalog_generation_equals",
      "equals": 2
    },
    {
      "type": "tool_catalog_contains",
      "name": "read_state"
    },
    {
      "type": "tool_input_json_equals",
      "name": "read_state",
      "input_json": "{\"key\":\"status\"}"
    },
    {
      "type": "tool_result_jsonpath_equals",
      "name": "read_state",
      "path": "$.value",
      "value": "recovered"
    },
    {
      "type": "tool_status_equals",
      "name": "read_state",
      "status": "completed"
    },
    {
      "type": "stale_tool_rejected",
      "tool_ref": "webmcp.tool-ref.v1:iXWiNo9N95l1B_hgbIvVDw"
    },
    {
      "type": "chrome_operation_order",
      "operations": [
        "connect",
        "select",
        "attach",
        "list_tools",
        "navigate",
        "list_tools",
        "invoke",
        "detach",
        "close"
      ]
    },
    {
      "type": "no_unexpected_chrome_operations",
      "operations": [
        "connect",
        "discover",
        "select",
        "attach",
        "list_tools",
        "navigate",
        "invoke",
        "detach",
        "close"
      ]
    },
    {
      "type": "generated_cdp_method_order",
      "methods": [
        "WebMCP.enable",
        "WebMCP.invokeTool"
      ]
    },
    {
      "type": "no_unexpected_generated_cdp_methods",
      "methods": [
        "WebMCP.enable",
        "WebMCP.invokeTool"
      ]
    },
    {
      "type": "no_pending_invocations"
    },
    {
      "type": "page_state_equals",
      "path": "$",
      "value": {}
    },
    {
      "type": "transcript_contains",
      "text": "fixture provider acknowledgement"
    },
    {
      "type": "browser_connection_closed"
    }
  ]
}
