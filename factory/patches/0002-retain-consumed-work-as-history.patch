+package projections
+
+import (
+	interfaces "github.com/portpowered/infinite-you/pkg/services/factory_definitions"
+	"github.com/portpowered/infinite-you/pkg/services/work"
+	workerexecution "github.com/portpowered/infinite-you/pkg/services/workers"
+	"testing"
+)
+
+func TestAcceptedCompletionRetiresConsumedInputButPreservesHistoryAndOutput(t *testing.T) {
+	for _, explicit := range []bool{true, false} {
+		r := newFactoryWorldReducer(2)
+		id := "retry-cycle"
+		cycle := work.FactoryWorkItem{ID: "cycle", WorkTypeID: "project-cycle", State: "init"}
+		project := work.FactoryWorkItem{ID: "project", WorkTypeID: "project", State: "init"}
+		for _, item := range []work.FactoryWorkItem{cycle, project} {
+			r.stateValue.WorkItemsByID[item.ID] = item
+			r.stateValue.ActiveWorkItemsByID[item.ID] = item
+		}
+		r.stateValue.ActiveDispatches[id] = interfaces.FactoryWorldDispatch{
+			DispatchID: id, WorkItemIDs: []string{cycle.ID, project.ID},
+			Inputs: []interfaces.WorkstationInput{{WorkItem: &cycle}, {WorkItem: &project}},
+		}
+		payload := workerexecution.DispatchResponseEventPayload{Outcome: workerexecution.OutcomeAccepted}
+		if explicit {
+			payload.OutputWork = &[]work.WorkRequestEventWork{{WorkID: project.ID, WorkTypeID: project.WorkTypeID}}
+		}
+		r.applyDispatchCompleted(interfaces.FactoryEvent{Context: interfaces.FactoryEventContext{DispatchID: &id, Tick: 2}}, payload)
+		_, active := r.stateValue.ActiveWorkItemsByID[cycle.ID]
+		if active == explicit {
+			t.Fatalf("explicit=%v: consumed cycle active=%v", explicit, active)
+		}
+		if r.stateValue.WorkItemsByID[cycle.ID].ID != cycle.ID {
+			t.Fatal("consumed history lost")
+		}
+		if r.stateValue.ActiveWorkItemsByID[project.ID].ID != project.ID {
+			t.Fatal("output project lost")
+		}
+		if len(r.stateValue.CompletedDispatches) != 1 || len(r.stateValue.CompletedDispatches[0].ConsumedInputs) != 2 {
+			t.Fatal("completion lineage lost")
+		}
+	}
+}
