{
  "name": "go-agent-harness",
  "resources": [
    {
      "id": "executor-slot",
      "name": "executor-slot",
      "capacity": 8
    },
    {
      "id": "concurrent-planners",
      "name": "concurrent-planners",
      "capacity": 1
    }
  ],
  "supportingFiles": {},
  "workTypes": [
    {
      "id": "thoughts",
      "name": "thoughts",
      "states": [
        {
          "id": "init",
          "name": "init",
          "type": "INITIAL"
        },
        {
          "id": "complete",
          "name": "complete",
          "type": "TERMINAL"
        },
        {
          "id": "failed",
          "name": "failed",
          "type": "FAILED"
        }
      ]
    },
    {
      "id": "task",
      "name": "task",
      "states": [
        {
          "id": "init",
          "name": "init",
          "type": "INITIAL"
        },
        {
          "id": "ci-pending",
          "name": "ci-pending",
          "type": "PROCESSING"
        },
        {
          "id": "in-review",
          "name": "in-review",
          "type": "PROCESSING"
        },
        {
          "id": "to-complete",
          "name": "to-complete",
          "type": "PROCESSING"
        },
        {
          "id": "complete",
          "name": "complete",
          "type": "TERMINAL"
        },
        {
          "id": "failed",
          "name": "failed",
          "type": "FAILED"
        }
      ]
    },
    {
      "id": "idea",
      "name": "idea",
      "states": [
        {
          "id": "init",
          "name": "init",
          "type": "INITIAL"
        },
        {
          "id": "to-complete",
          "name": "to-complete",
          "type": "PROCESSING"
        },
        {
          "id": "complete",
          "name": "complete",
          "type": "TERMINAL"
        },
        {
          "id": "failed",
          "name": "failed",
          "type": "FAILED"
        }
      ]
    },
    {
      "id": "plan",
      "name": "plan",
      "states": [
        {
          "id": "init",
          "name": "init",
          "type": "INITIAL"
        },
        {
          "id": "complete",
          "name": "complete",
          "type": "TERMINAL"
        },
        {
          "id": "failed",
          "name": "failed",
          "type": "FAILED"
        }
      ]
    },
    {
      "id": "review",
      "name": "review",
      "states": [
        {
          "id": "init",
          "name": "init",
          "type": "INITIAL"
        },
        {
          "id": "complete",
          "name": "complete",
          "type": "TERMINAL"
        },
        {
          "id": "fin",
          "name": "fin",
          "type": "FAILED"
        }
      ]
    },
    {
      "id": "project",
      "name": "project",
      "states": [
        {
          "id": "init",
          "name": "init",
          "type": "INITIAL"
        },
        {
          "id": "complete",
          "name": "complete",
          "type": "TERMINAL"
        },
        {
          "id": "blocked",
          "name": "blocked",
          "type": "FAILED"
        }
      ]
    }
  ],
  "workers": [
    {
      "executorProvider": "SCRIPT_WRAP",
      "modelProvider": "codex",
      "model": "gpt-5.6-luna",
      "reasoningEffort": "xhigh",
      "name": "processor",
      "skipPermissions": true,
      "type": "AGENT_WORKER",
      "timeout": "4h"
    },
    {
      "args": [
        "factory/scripts/prepare-workspace.py",
        "{{ (index .Inputs 0).Name }}"
      ],
      "command": "python3",
      "id": "workspace-setup",
      "name": "workspace-setup",
      "type": "SCRIPT_WORKER"
    },
    {
      "executorProvider": "SCRIPT_WRAP",
      "modelProvider": "codex",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "medium",
      "id": "planner",
      "name": "planner",
      "skipPermissions": true,
      "type": "AGENT_WORKER",
      "timeout": "4h"
    },
    {
      "executorProvider": "SCRIPT_WRAP",
      "modelProvider": "codex",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "medium",
      "id": "ideafier",
      "name": "ideafier",
      "skipPermissions": true,
      "type": "AGENT_WORKER",
      "timeout": "4h"
    },
    {
      "executorProvider": "SCRIPT_WRAP",
      "modelProvider": "codex",
      "model": "gpt-5.6-luna",
      "reasoningEffort": "xhigh",
      "name": "reviewer",
      "skipPermissions": true,
      "type": "AGENT_WORKER",
      "timeout": "4h"
    },
    {
      "id": "ci-gate",
      "name": "ci-gate",
      "type": "SCRIPT_WORKER",
      "command": "python3",
      "args": [
        "factory/scripts/ci-gate.py",
        "{{ (index .Inputs 0).Name }}"
      ],
      "timeout": "110m"
    }
  ],
  "workstations": [
    {
      "id": "ideafy",
      "inputs": [
        {
          "state": "init",
          "workType": "thoughts"
        }
      ],
      "name": "ideafy",
      "onFailure": [
        {
          "state": "failed",
          "workType": "thoughts"
        }
      ],
      "outputs": [
        {
          "state": "complete",
          "workType": "thoughts"
        }
      ],
      "resources": [
        {
          "capacity": 1,
          "name": "concurrent-planners"
        }
      ],
      "type": "AGENT_RUN",
      "worker": "ideafier"
    },
    {
      "id": "plan",
      "inputs": [
        {
          "state": "init",
          "workType": "idea"
        }
      ],
      "name": "plan",
      "onFailure": [
        {
          "state": "failed",
          "workType": "idea"
        },
        {
          "workType": "thoughts",
          "state": "init"
        }
      ],
      "onRejection": [
        {
          "state": "failed",
          "workType": "idea"
        },
        {
          "workType": "thoughts",
          "state": "init"
        }
      ],
      "outputs": [
        {
          "state": "to-complete",
          "workType": "idea"
        },
        {
          "state": "init",
          "workType": "plan"
        }
      ],
      "resources": [
        {
          "name": "concurrent-planners",
          "capacity": 1
        }
      ],
      "type": "AGENT_RUN",
      "worker": "planner",
      "outcomeFormat": "decision-envelope",
      "onContinue": [
        {
          "workType": "idea",
          "state": "failed"
        },
        {
          "workType": "thoughts",
          "state": "init"
        }
      ]
    },
    {
      "id": "consume",
      "inputs": [
        {
          "guards": [
            {
              "matchInput": "task",
              "type": "SAME_NAME"
            }
          ],
          "state": "to-complete",
          "workType": "idea"
        },
        {
          "state": "to-complete",
          "workType": "task"
        }
      ],
      "name": "consume",
      "outputs": [
        {
          "state": "complete",
          "workType": "idea"
        },
        {
          "state": "complete",
          "workType": "task"
        },
        {
          "workType": "thoughts",
          "state": "init"
        }
      ],
      "type": "LOGICAL_MOVE",
      "worker": ""
    },
    {
      "id": "setup-workspace",
      "inputs": [
        {
          "state": "init",
          "workType": "plan"
        }
      ],
      "name": "setup-workspace",
      "onFailure": [
        {
          "state": "failed",
          "workType": "plan"
        },
        {
          "workType": "thoughts",
          "state": "init"
        }
      ],
      "outputs": [
        {
          "state": "complete",
          "workType": "plan"
        },
        {
          "state": "init",
          "workType": "task"
        }
      ],
      "type": "SCRIPT_RUN",
      "worker": "workspace-setup"
    },
    {
      "behavior": "REPEATER",
      "id": "process",
      "inputs": [
        {
          "state": "init",
          "workType": "task"
        }
      ],
      "name": "process",
      "onContinue": [
        {
          "state": "init",
          "workType": "task"
        }
      ],
      "onFailure": [
        {
          "state": "failed",
          "workType": "task"
        },
        {
          "workType": "thoughts",
          "state": "init"
        }
      ],
      "onRejection": [
        {
          "workType": "task",
          "state": "failed"
        },
        {
          "workType": "thoughts",
          "state": "init"
        }
      ],
      "outputs": [
        {
          "workType": "task",
          "state": "ci-pending"
        }
      ],
      "resources": [
        {
          "capacity": 1,
          "name": "executor-slot"
        }
      ],
      "type": "AGENT_RUN",
      "worker": "processor",
      "workingDirectory": ".claude/worktrees/{{ (index .Inputs 0).Name }}",
      "outcomeFormat": "decision-envelope"
    },
    {
      "id": "review",
      "inputs": [
        {
          "state": "in-review",
          "workType": "task"
        },
        {
          "state": "init",
          "workType": "review",
          "guards": [
            {
              "type": "SAME_NAME",
              "matchInput": "task"
            }
          ]
        }
      ],
      "name": "review",
      "onFailure": [
        {
          "state": "failed",
          "workType": "task"
        },
        {
          "state": "fin",
          "workType": "review"
        },
        {
          "workType": "thoughts",
          "state": "init"
        }
      ],
      "onRejection": [
        {
          "state": "init",
          "workType": "task"
        },
        {
          "workType": "review",
          "state": "fin"
        }
      ],
      "outputs": [
        {
          "state": "to-complete",
          "workType": "task"
        },
        {
          "state": "complete",
          "workType": "review"
        }
      ],
      "resources": [
        {
          "name": "executor-slot",
          "capacity": 1
        }
      ],
      "type": "AGENT_RUN",
      "worker": "reviewer",
      "workingDirectory": ".claude/worktrees/{{ (index .Inputs 0).Name }}",
      "outcomeFormat": "decision-envelope",
      "onContinue": [
        {
          "workType": "task",
          "state": "ci-pending"
        },
        {
          "workType": "review",
          "state": "fin"
        }
      ]
    },
    {
      "behavior": "CRON",
      "cron": {
        "schedule": "0 */4 * * *"
      },
      "id": "though-retrigger",
      "inputs": [],
      "name": "though-retrigger",
      "outputs": [
        {
          "state": "init",
          "workType": "thoughts"
        }
      ],
      "type": "LOGICAL_MOVE",
      "worker": ""
    },
    {
      "id": "ci-gate",
      "name": "ci-gate",
      "type": "SCRIPT_RUN",
      "worker": "ci-gate",
      "outcomeFormat": "decision-envelope",
      "inputs": [
        {
          "workType": "task",
          "state": "ci-pending"
        }
      ],
      "outputs": [
        {
          "workType": "task",
          "state": "in-review"
        },
        {
          "workType": "review",
          "state": "init"
        }
      ],
      "onRejection": [
        {
          "workType": "task",
          "state": "init"
        }
      ],
      "onFailure": [
        {
          "workType": "task",
          "state": "failed"
        },
        {
          "workType": "thoughts",
          "state": "init"
        }
      ]
    }
  ]
}
