  "workers": [
    {
      "executorProvider": "SCRIPT_WRAP",
      "modelProvider": "codex",
      "model": "gpt-6-astra",
      "reasoningEffort": "medium",
      "id": "project-lead",
      "name": "project-lead",
      "skipPermissions": true,
      "type": "AGENT_WORKER",
      "timeout": "1h"
    },
    {
      "args": [
        "factory/scripts/decide-project-cycle.py",
        "{{ (index .Inputs 0).Payload }}"
      ],
      "command": "python3",
      "id": "project-cycle-decider",
      "name": "project-cycle-decider",
      "type": "SCRIPT_WORKER"
    },
    {
      "executorProvider": "SCRIPT_WRAP",
      "modelProvider": "codex",
      "model": "gpt-5.6-luna",
      "reasoningEffort": "max",
      "name": "processor",
      "skipPermissions": true,
      "type": "AGENT_WORKER",
      "timeout": "1h"
    },
    {
      "executorProvider": "SCRIPT_WRAP",
      "modelProvider": "codex",
      "model": "gpt-5.6-luna",
      "reasoningEffort": "max",
      "name": "reviewer",
      "skipPermissions": true,
      "type": "AGENT_WORKER",
      "timeout": "1h"
    },
    {
      "args": [
        "factory/scripts/prepare-workspace.py",
        "{{ (index .Inputs 0).Name }}"
      ],
      "command": "python3",
      "id": "workspace-setup",
      "name": "workspace-setup",
      "type": "SCRIPT_WORKER"
    },
    {
      "args": [
        "factory/scripts/ci-wait.py",
        "codex/{{ (index .Inputs 0).Name }}"
      ],
      "command": "python3",
      "id": "ci-waiter",
      "name": "ci-waiter",
      "type": "SCRIPT_WORKER"
    },
    {
      "executorProvider": "SCRIPT_WRAP",
      "modelProvider": "codex",
      "model": "gpt-6-astra",
      "reasoningEffort": "medium",
      "id": "planner",
      "name": "planner",
      "skipPermissions": true,
      "type": "AGENT_WORKER",
      "timeout": "1h"
    },
    {
      "executorProvider": "SCRIPT_WRAP",
      "modelProvider": "codex",
      "model": "gpt-6-astra",
      "reasoningEffort": "medium",
      "id": "ideafier",
      "name": "ideafier",
      "skipPermissions": true,
      "type": "AGENT_WORKER",
      "timeout": "1h"
    },
    {
      "id": "validation-setup",
      "name": "validation-setup",
      "type": "SCRIPT_WORKER",
      "command": "python3",
      "args": [
        "factory/scripts/prepare-validation.py",
        "{{ (index .Inputs 0).Name }}",
        "{{ (index .Inputs 0).Payload }}"
      ]
    },
    {
      "id": "validator",
      "name": "validator",
      "type": "AGENT_WORKER",
      "executorProvider": "SCRIPT_WRAP",
      "modelProvider": "codex",
      "model": "gpt-5.6-luna",
      "reasoningEffort": "max",
      "skipPermissions": true,
      "timeout": "30m"
    },
    {
      "id": "project-reconciler",
      "name": "project-reconciler",
      "type": "SCRIPT_WORKER",
      "command": "python3",
      "args": [
        "factory/scripts/reconcile-projects.py",
        "--server",
        "http://127.0.0.1:7439",
        "--session",
        "{{ .Context.SessionID }}"
      ]
    },
    {
      "id": "admit-project",
      "name": "admit-project",
      "type": "SCRIPT_WORKER",
      "command": "python3",
      "args": [
        "factory/scripts/project-control.py",
        "verify-work",
        "--type",
        "project",
        "--name",
        "{{ (index .Inputs 0).Name }}",
        "--payload",
        "{{ (index .Inputs 0).Payload }}"
      ]
    },
    {
      "id": "admit-idea",
      "name": "admit-idea",
      "type": "SCRIPT_WORKER",
      "command": "python3",
      "args": [
        "factory/scripts/project-control.py",
        "verify-work",
        "--type",
        "idea",
        "--name",
        "{{ (index .Inputs 0).Name }}",
        "--payload",
        "{{ (index .Inputs 0).Payload }}"
      ]
    },
    {
      "id": "admit-task",
      "name": "admit-task",
      "type": "SCRIPT_WORKER",
      "command": "python3",
      "args": [
        "factory/scripts/project-control.py",
        "verify-work",
        "--type",
        "task",
        "--name",
        "{{ (index .Inputs 0).Name }}",
        "--payload",
        "{{ (index .Inputs 0).Payload }}"
      ]
    },
    {
      "id": "completion-checker",
      "name": "completion-checker",
      "type": "SCRIPT_WORKER",
      "command": "python3",
      "args": [
        "factory/scripts/project-control.py",
        "verify-completion",
        "--name",
        "{{ (index .Inputs 0).Name }}"
      ]
    }
  ],
  "workstations": [
    {
      "id": "project-lead",
      "inputs": [
        {
          "state": "admitted",
          "workType": "project"
        }
      ],
      "name": "project-lead",
      "onFailure": [
        {
          "state": "needs-supervision",
          "workType": "project"
        }
      ],
      "outputs": [
        {
          "state": "waiting",
          "workType": "project"
        }
      ],
      "resources": [
        {
          "name": "manager-slot",
          "capacity": 1
        }
      ],
      "type": "AGENT_RUN",
      "worker": "project-lead",
      "workPropagation": {
        "mode": "PRESERVE_INPUT"
      }
    },
    {
      "classificationRoutes": [
        {
          "label": "continue",
          "outputs": [
            {
              "state": "continue",
              "workType": "project-cycle"
            }
          ]
        },
        {
          "label": "complete",
          "outputs": [
            {
              "state": "complete",
              "workType": "project-cycle"
            }
          ]
        },
        {
          "label": "blocked",
          "outputs": [
            {
              "state": "blocked",
              "workType": "project-cycle"
            }
          ]
        }
      ],
      "id": "decide-project-cycle",
      "inputs": [
        {
          "state": "init",
          "workType": "project-cycle"
        }
      ],
      "name": "decide-project-cycle",
      "onFailure": [
        {
          "state": "failed",
          "workType": "project-cycle"
        }
      ],
      "type": "CLASSIFIER_WORKSTATION",
      "worker": "project-cycle-decider"
    },
    {
      "id": "continue-project",
      "inputs": [
        {
          "guards": [
            {
              "matchInput": "project-cycle",
              "type": "SAME_NAME"
            }
          ],
          "state": "waiting",
          "workType": "project"
        },
        {
          "state": "continue",
          "workType": "project-cycle"
        }
      ],
      "name": "continue-project",
      "outputs": [
        {
          "state": "init",
          "workType": "project"
        },
        {
          "workType": "project-cycle",
          "state": "fin"
        }
      ],
      "type": "LOGICAL_MOVE",
      "worker": ""
    },
    {
      "id": "complete-project",
      "inputs": [
        {
          "guards": [
            {
              "matchInput": "project-cycle",
              "type": "SAME_NAME"
            }
          ],
          "state": "waiting",
          "workType": "project"
        },
        {
          "state": "complete",
          "workType": "project-cycle"
        }
      ],
      "name": "complete-project",
      "outputs": [
        {
          "state": "validating-completion",
          "workType": "project"
        }
      ],
      "type": "LOGICAL_MOVE",
      "worker": ""
    },
    {
      "id": "retry-project-after-cycle-failure",
      "inputs": [
        {
          "guards": [
            {
              "matchInput": "project-cycle",
              "type": "SAME_NAME"
            }
          ],
          "state": "waiting",
          "workType": "project"
        },
        {
          "state": "failed",
          "workType": "project-cycle"
        }
      ],
      "name": "retry-project-after-cycle-failure",
      "outputs": [
        {
          "state": "init",
          "workType": "project"
        }
      ],
      "type": "LOGICAL_MOVE",
      "worker": ""
    },
    {
      "id": "block-project",
      "inputs": [
        {
          "guards": [
            {
              "matchInput": "project-cycle",
              "type": "SAME_NAME"
            }
          ],
          "state": "waiting",
          "workType": "project"
        },
        {
          "state": "blocked",
          "workType": "project-cycle"
        }
      ],
      "name": "block-project",
      "outputs": [
        {
          "state": "needs-supervision",
          "workType": "project"
        }
      ],
      "type": "LOGICAL_MOVE",
      "worker": ""
    },
    {
      "guards": [
        {
          "maxVisits": 12,
          "type": "VISIT_COUNT",
          "workstation": "project-lead"
        }
      ],
      "id": "project-loop-breaker",
      "inputs": [
        {
          "state": "admitted",
          "workType": "project"
        }
      ],
      "name": "project-loop-breaker",
      "outputs": [
        {
          "state": "needs-supervision",
          "workType": "project"
        }
      ],
      "type": "LOGICAL_MOVE",
      "worker": ""
    },
    {
      "id": "ideafy",
      "inputs": [
        {
          "state": "init",
          "workType": "thoughts"
        }
      ],
      "name": "ideafy",
      "onFailure": [
        {
          "state": "failed",
          "workType": "thoughts"
        }
      ],
      "outputs": [
        {
          "state": "complete",
          "workType": "thoughts"
        }
      ],
      "resources": [
        {
          "name": "manager-slot",
          "capacity": 1
        }
      ],
      "type": "AGENT_RUN",
      "worker": "ideafier"
    },
    {
      "id": "plan",
      "inputs": [
        {
          "state": "admitted",
          "workType": "idea"
        }
      ],
      "name": "plan",
      "onFailure": [
        {
          "state": "failed",
          "workType": "idea"
        }
      ],
      "onRejection": [
        {
          "workType": "idea",
          "state": "failed"
        }
      ],
      "outputs": [
        {
          "state": "to-complete",
          "workType": "idea"
        },
        {
          "state": "init",
          "workType": "plan"
        }
      ],
      "resources": [
        {
          "name": "manager-slot",
          "capacity": 1
        }
      ],
      "type": "AGENT_RUN",
      "worker": "planner",
      "outcomeFormat": "decision-envelope",
      "onContinue": [
        {
          "workType": "idea",
          "state": "failed"
        }
      ]
    },
    {
      "id": "consume",
      "inputs": [
        {
          "guards": [
            {
              "matchInput": "task",
              "type": "SAME_NAME"
            }
          ],
          "state": "to-complete",
          "workType": "idea"
        },
        {
          "state": "to-complete",
          "workType": "task"
        }
      ],
      "name": "consume",
      "outputs": [
        {
          "state": "complete",
          "workType": "idea"
        },
        {
          "state": "complete",
          "workType": "task"
        }
      ],
      "type": "LOGICAL_MOVE",
      "worker": ""
    },
    {
      "id": "setup-workspace",
      "inputs": [
        {
          "state": "init",
          "workType": "plan"
        }
      ],
      "name": "setup-workspace",
      "onFailure": [
        {
          "state": "failed",
          "workType": "plan"
        }
      ],
      "outputs": [
        {
          "state": "complete",
          "workType": "plan"
        },
        {
          "state": "init",
          "workType": "task"
        }
      ],
      "type": "SCRIPT_RUN",
      "worker": "workspace-setup"
    },
    {
      "id": "ci-wait",
      "inputs": [
        {
          "state": "awaiting-ci",
          "workType": "task"
        }
      ],
      "name": "ci-wait",
      "onFailure": [
        {
          "state": "failed",
          "workType": "task"
        }
      ],
      "outputs": [
        {
          "state": "in-review",
          "workType": "task"
        }
      ],
      "type": "SCRIPT_RUN",
      "worker": "ci-waiter"
    },
    {
      "behavior": "REPEATER",
      "id": "process",
      "inputs": [
        {
          "state": "admitted",
          "workType": "task"
        }
      ],
      "name": "process",
      "onContinue": [
        {
          "state": "init",
          "workType": "task"
        }
      ],
      "onFailure": [
        {
          "state": "failed",
          "workType": "task"
        }
      ],
      "onRejection": [
        {
          "workType": "task",
          "state": "failed"
        }
      ],
      "outputs": [
        {
          "state": "awaiting-ci",
          "workType": "task"
        },
        {
          "state": "init",
          "workType": "review"
        }
      ],
      "resources": [
        {
          "capacity": 1,
          "name": "executor-slot"
        }
      ],
      "type": "AGENT_RUN",
      "worker": "processor",
      "workingDirectory": ".claude/worktrees/{{ (index .Inputs 0).Name }}",
      "outcomeFormat": "decision-envelope"
    },
    {
      "behavior": "REPEATER",
      "id": "review",
      "inputs": [
        {
          "state": "in-review",
          "workType": "task"
        },
        {
          "guards": [
            {
              "matchInput": "task",
              "type": "SAME_NAME"
            }
          ],
          "state": "init",
          "workType": "review"
        }
      ],
      "name": "review",
      "onContinue": [
        {
          "state": "awaiting-ci",
          "workType": "task"
        },
        {
          "state": "init",
          "workType": "review"
        }
      ],
      "onFailure": [
        {
          "state": "failed",
          "workType": "task"
        },
        {
          "state": "fin",
          "workType": "review"
        }
      ],
      "onRejection": [
        {
          "state": "init",
          "workType": "task"
        },
        {
          "workType": "review",
          "state": "fin"
        }
      ],
      "outputs": [
        {
          "state": "to-complete",
          "workType": "task"
        },
        {
          "state": "complete",
          "workType": "review"
        }
      ],
      "resources": [
        {
          "name": "executor-slot",
          "capacity": 1
        },
        {
          "name": "merge-slot",
          "capacity": 1
        }
      ],
      "type": "AGENT_RUN",
      "worker": "reviewer",
      "workingDirectory": ".claude/worktrees/{{ (index .Inputs 0).Name }}",
      "outcomeFormat": "decision-envelope"
    },
    {
      "guards": [
        {
          "logicalRoundTrip": {
            "maxRawVisits": 24,
            "workstations": [
              "process",
              "review"
            ]
          },
          "maxVisits": 12,
          "type": "VISIT_COUNT",
          "workstation": "process"
        }
      ],
      "id": "executor-loop-breaker",
      "inputs": [
        {
          "state": "admitted",
          "workType": "task"
        }
      ],
      "name": "executor-loop-breaker",
      "outputs": [
        {
          "state": "failed",
          "workType": "task"
        }
      ],
      "type": "LOGICAL_MOVE",
      "worker": ""
    },
    {
      "guards": [
        {
          "logicalRoundTrip": {
            "maxRawVisits": 24,
            "workstations": [
              "process",
              "review"
            ]
          },
          "maxVisits": 12,
          "type": "VISIT_COUNT",
          "workstation": "review"
        }
      ],
      "id": "review-loop-breaker",
      "inputs": [
        {
          "state": "in-review",
          "workType": "task"
        }
      ],
      "name": "review-loop-breaker",
      "outputs": [
        {
          "state": "failed",
          "workType": "task"
        }
      ],
      "type": "LOGICAL_MOVE",
      "worker": ""
    },
    {
      "behavior": "CRON",
      "cron": {
        "schedule": "0 */4 * * *"
      },
      "id": "though-retrigger",
      "inputs": [],
      "name": "though-retrigger",
      "outputs": [
        {
          "state": "init",
          "workType": "thoughts"
        }
      ],
      "type": "LOGICAL_MOVE",
      "worker": ""
    },
    {
      "id": "escalate-plan-failure",
      "name": "escalate-plan-failure",
      "type": "LOGICAL_MOVE",
